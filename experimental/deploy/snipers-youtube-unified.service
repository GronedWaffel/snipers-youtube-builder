# /etc/systemd/system/snipers-youtube-unified.service
[Unit]
Description=Snipers unified PS5 11.00-13.60 builder
After=network.target

[Service]
Type=simple
User=snipers-builder-unified
Group=snipers-builder-unified
WorkingDirectory=/opt/snipers-youtube-unified/current
ExecStart=/opt/snipers-youtube-builder/runtimes/node-v24.21.0-linux-x64/bin/node relapse-host/builder/server/start.mjs
Environment=PORT=8792
Environment=BUILDER_STORAGE=/var/lib/snipers-youtube-unified/jobs
Environment=BUILDER_ORIGIN=https://sniperscheats.lol
Environment=BUNDLE_ADDRESS=64.20.57.42
Environment=BUNDLE_HOST=sniperscheats.lol
Environment=SNIPERS_BUILDS=1
Environment=SNIPERS_INSTALL_ENABLED=1
Environment=SNIPERS_MAX_JOBS=100
Environment=SNIPERS_BUILD_WORKERS=2
Environment=ZIG=/opt/snipers-youtube-builder/runtimes/zig-x86_64-linux-0.14.1/zig
Environment=PS5_PAYLOAD_SDK=/opt/snipers-youtube-builder/releases/20261003071207/ps-neighbourhood/tools/ps5-sdk-0.43/ps5-payload-sdk
Environment=DOTNET=/opt/snipers-youtube-builder/runtimes/dotnet-10/dotnet
Environment=DOTNET_ROOT=/opt/snipers-youtube-builder/runtimes/dotnet-10
Environment=DOTNET_ROLL_FORWARD=Major
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
Environment=SNIPERS_UFS_DLL=/opt/snipers-youtube-unified/current/relapse-y2jb/tools/ufs2/bin/Release/net9.0/ImageBuilder.dll
Environment=ZIG_GLOBAL_CACHE_DIR=/var/lib/snipers-youtube-unified/zig-global
Environment=ZIG_LOCAL_CACHE_DIR=/var/lib/snipers-youtube-unified/zig-local
Environment=HOME=/var/lib/snipers-youtube-unified
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_GENERATE_ASPNET_CERTIFICATE=false
UMask=0077
IOSchedulingClass=idle
IOWeight=10
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/snipers-youtube-unified
MemoryHigh=2G
MemoryMax=3G
CPUQuota=200%
CPUWeight=20
Nice=10

[Install]
WantedBy=multi-user.target
